# ═══════════════════════════════════════════════════════
# 🛡️ BRIEFLYAI — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════
# NUNCA commite o arquivo .env real no Git!

# Chave de API da Groq (LLaMA 3 / Whisper)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection String
MONGO_URI=mongodb+srv://your_connection_string_here

# JWT Secret — Use uma chave forte e aleatória (mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_here

# Porta do servidor
PORT=3001

# CORS — Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Resend API — Envio de emails (obtenha em: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# URL do frontend (para links de recuperação de senha)
CLIENT_URL=http://localhost:5174

# VirusTotal — scan de uploads de áudio (opcional; sem chave = fail-open)
# Obtenha em: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Prometheus /metrics — token Bearer para proteger o endpoint (opcional)
METRICS_TOKEN=

# Audit log — TTL em dias (padrão 365)
AUDIT_LOG_TTL_DAYS=365

# HIBP — defina como "true" para pular verificação em dev
HIBP_DISABLED=
